<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: no cleartext; trust system CAs and user-installed CAs (lead
  decision 5, for corporate/self-hosted TLS). SSH host keys are unaffected.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
