<?xml version="1.0" encoding="utf-8"?>
<!-- NoriShell launcher icon: the desktop master's porcelain base as the background layer
     (the system mask gives it its shape) and the master's two-tone N as the foreground,
     kept inside the 66dp safe zone. The monochrome layer is the brand mark silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
