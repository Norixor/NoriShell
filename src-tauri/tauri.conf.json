{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoriShell",
  "version": "0.1.4",
  "identifier": "app.norishell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NoriShell",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src 'self' norishell-plugin: http://norishell-plugin.localhost https://norishell-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNkY1NjlCOTI1NjMxRkEKUldUNk1WYVNtMVp2d3R2bTJMZ3Z4cG0xd1huNmFIUkJRZk83YnV2ODhlTG9ZWi9QQWdDWE51UTMK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/Norixor/NoriShell/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
