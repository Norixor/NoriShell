{
  "schemaVersion": 1,
  "fields": [
    {
      "type": "string",
      "key": "serverUrl",
      "label": {
        "en": "Server URL or IP:port",
        "zh-CN": "服务器地址或 IP:端口"
      },
      "default": "",
      "maxLength": 512
    },
    {
      "type": "select",
      "key": "conflictPolicy",
      "label": {
        "en": "When the same item changes on two devices",
        "zh-CN": "两台设备修改同一项目时"
      },
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": {
            "en": "Use the newer update automatically",
            "zh-CN": "自动采用较新修改"
          }
        },
        {
          "value": "prompt",
          "label": {
            "en": "Ask me to choose",
            "zh-CN": "由我选择"
          }
        }
      ]
    },
    {
      "type": "select",
      "key": "deletionPolicy",
      "label": {
        "en": "When a newer update deletes an item",
        "zh-CN": "较新修改删除项目时"
      },
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": {
            "en": "Delete automatically",
            "zh-CN": "自动删除"
          }
        },
        {
          "value": "prompt",
          "label": {
            "en": "Ask",
            "zh-CN": "询问"
          }
        }
      ]
